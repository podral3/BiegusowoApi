{
    "Serilog": {
      "MinimumLevel": {
        "Default": "Debug",
        "Override": {
          "Microsoft": "Warning",
          "Microsoft.EntityFrameworkCore.Database.Command": "Information"
        }
      },
      "WriteTo": [
        { "Name": "Console" }
      ],
      "Enrich": [
        "FromLogContext"
      ]
    },
    "AllowedHosts": "*"
}
